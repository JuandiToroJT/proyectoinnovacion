@model ProyectoInventariosWebApp.Models.Pedidos

@{
    ViewData["Title"] = "Detalles del Pedido";
    var esProcesado = (bool)(ViewData["EsProcesado"] ?? false);
    var tieneError = TempData["Error"] != null;
    bool esProcesadoConProd = !esProcesado && Model.DetallesPedido != null && Model.DetallesPedido.Any();
}

<div class="container mt-4">
    @if (tieneError)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="card shadow-sm p-4 mb-4">
        <h2 class="mb-4">Pedido #@Model.IdPedido</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">Fecha</dt>
            <dd class="col-sm-9">@(Model.Fecha?.ToString("yyyy-MM-dd"))</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Estado</dd>
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.IdClienteNavigation.Nombre</dd>
            <dt class="col-sm-3">Empleado</dt>
            <dd class="col-sm-9">@Model.IdUsuarioNavigation.Nombre</dd>
        </dl>
    </div>

    <h4 class="mb-3">Productos en el pedido</h4>
    @if (Model.DetallesPedido == null || !Model.DetallesPedido.Any())
    {
        <div class="alert alert-info">No hay productos agregados.</div>
    }
    else
    {
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    @if (!esProcesado)
                    {
                        <th class="text-center">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var det in Model.DetallesPedido)
                {
                    <tr>
                        <td>@det.IdProductoNavigation.Nombre</td>
                        <td>@det.Cantidad</td>
                        <td>@((det.Subtotal ?? 0).ToString("C"))</td>
                        @if (!esProcesado)
                        {
                            <td class="text-center">
                                <a asp-controller="DetallesPedidos" asp-action="Edit" asp-route-id="@det.IdDetalle" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                                <form asp-controller="DetallesPedidos" asp-action="Delete" asp-route-id="@det.IdDetalle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="background-color: red;">Eliminar</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="d-flex justify-content-between mt-4">
        @if (!esProcesado)
        {
            <a asp-controller="DetallesPedidos" asp-action="Create" asp-route-idPedido="@Model.IdPedido" class="btn btn-primary">Agregar Producto</a>
        }
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>

    @if (esProcesadoConProd)
    {
        <div class="card shadow mt-5">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-robot me-2"></i>Sugerencias de la Inteligencia Artificial</h5>
            </div>
            <div class="card-body">
                <p class="card-text text-muted">Basado en el historial de pedidos con los productos seleccionados, la IA sugiere:</p>

                <div id="iaSugerenciasList" class="list-group list-group-flush">
                    <p class="text-center text-info" id="iaCargaMensaje">
                        <i class="bi bi-arrow-clockwise spinner-border spinner-border-sm me-2"></i> Analizando el pedido...
                    </p>
                </div>

            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const apiUrl = '@ViewBag.ApiUrl';
            const esProcesadoConProd = @Html.Raw(esProcesadoConProd.ToString().ToLower());
            const idPedido = @Model.IdPedido;

            function agregarSugerenciaAI(data) {
                let html = '';
                const productos = data.productosSugeridos || [];
                const frase = data.fraseVenta || "Complementa tu pedido con estas opciones.";

                if (productos.length === 0) {
                    html = '<div class="alert alert-light text-center">La IA no encontró productos complementarios relevantes para este pedido.</div>';
                } else {
                    html += `<div class="alert alert-success mt-2 mb-3"><strong><i class="bi bi-megaphone me-2"></i> ${frase}</strong></div>`;

                    html += '<ul class="list-group">';
                    productos.forEach(function(producto) {
                        html += `
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="me-auto">
                                    <strong>${producto}</strong>
                                </span>
                            </li>
                        `;
                    });
                    html += '</ul>';
                }

                $('#iaSugerenciasList').html(html);
            }

            function cargarSugerenciasAI(idPedido) {
                const tipoCliente = 'Estudiante';

                const productosEnPedido = @Html.Raw(Json.Serialize(Model.DetallesPedido.Select(dp => dp.IdProductoNavigation.Nombre).ToList()));

                const requestBody = {
                    TipoCliente: tipoCliente,
                    Productos: productosEnPedido
                };

                const url = apiUrl + '/IA/recomendacion-caja';

                $('#iaSugerenciasList').html('<p class="text-center text-info" id="iaCargaMensaje"><i class="bi bi-arrow-clockwise spinner-border spinner-border-sm me-2"></i> Analizando el pedido...</p>');

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestBody),
                    success: function(data) {
                        if (data && data.productosSugeridos) {
                            agregarSugerenciaAI(data);
                        } else {
                            $('#iaSugerenciasList').html('<div class="alert alert-light text-center">No hay sugerencias disponibles en este momento.</div>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("Error al llamar a la IA:", error);
                        const errorMsg = xhr.status === 404 ?
                            'Error 404: La URL de la API no se encontró. Revisa la ruta.' :
                            'Error al conectar con el servicio de Sugerencias AI.';

                        $('#iaSugerenciasList').html(`<div class="alert alert-danger text-center">${errorMsg}</div>`);
                    }
                });
            }

            if (esProcesadoConProd) {
                cargarSugerenciasAI(idPedido);
            }
        });
    </script>
}