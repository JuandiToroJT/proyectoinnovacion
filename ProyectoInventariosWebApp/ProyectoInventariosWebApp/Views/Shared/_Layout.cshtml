<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Universidad de Caldas</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoInventariosWebApp.styles.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #3b82f6;
            --secondary-color: #2563eb;
            --hover-color: #1d4ed8;
        }

        body {
            background-color: #f3f6fb;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* === NAVBAR === */
        .navbar-custom {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            box-shadow: 0 2px 15px rgba(59, 130, 246, 0.2);
            padding: 0.75rem 0;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 600;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            transition: opacity 0.3s;
        }

            .navbar-brand:hover {
                opacity: 0.9;
            }

            .navbar-brand .logo {
                height: 40px;
                margin-right: 12px;
                filter: brightness(0) invert(1);
            }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,0.95) !important;
            margin: 0 8px;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .navbar-nav .nav-link:hover {
                background: rgba(255,255,255,0.15);
                color: white !important;
                transform: translateY(-2px);
            }

            .navbar-nav .nav-link i {
                font-size: 1.1rem;
            }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 8px 0;
        }

        .user-badge {
            background: rgba(255,255,255,0.15);
            padding: 8px 16px;
            border-radius: 20px;
            color: white;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,0.2);
        }

            .user-badge strong {
                font-weight: 600;
            }

        .btn-logout {
            background: rgba(220, 53, 69, 0.9);
            border: none;
            color: white;
            padding: 8px 20px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .btn-logout:hover {
                background: #dc3545;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
            }

            .btn-logout i {
                font-size: 1rem;
            }

        /* === CONTENEDOR PRINCIPAL === */
        .content-wrapper {
            padding: 30px 0;
        }

        .main-container {
            background-color: #ffffff;
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            min-height: 400px;
        }

        /* === FOOTER === */
        footer.footer {
            background-color: #ffffff;
            border-top: 1px solid #e5e7eb;
            padding: 1.5rem 0;
            margin-top: 40px;
            font-size: 0.9rem;
            color: #6b7280;
        }

            footer.footer strong {
                color: var(--primary-color);
                font-weight: 600;
            }

        /* === RESPONSIVE === */
        @@media (max-width: 991px) {
            .navbar-nav {
                margin-top: 1rem;
            }

                .navbar-nav .nav-link {
                    margin: 5px 0;
                }

            .user-info {
                flex-direction: column;
                align-items: flex-start;
                margin-top: 1rem;
                gap: 10px;
            }

            .user-badge {
                width: 100%;
                justify-content: center;
            }

            .btn-logout {
                width: 100%;
                justify-content: center;
            }
        }

        /* === ANIMACIONES === */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .main-container {
            animation: fadeIn 0.5s ease-out;
        }

        /* === MEJORAS VISUALES === */
        .navbar-toggler {
            border-color: rgba(255,255,255,0.3);
            padding: 0.5rem;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 0.2rem rgba(255,255,255,0.25);
            }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }
    </style>
</head>
<body>
    <header>
        @if (UsuarioLogueado.Id.HasValue)
        {
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img class="logo" src="@Url.Content("~/logo.png")" alt="Logo" />
                    <span>Universidad de Caldas</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i>
                                <span>Inicio</span>
                            </a>
                        </li>

                        @if (UsuarioLogueado.Rol == "SuperAdmin")
                            {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Sedes" asp-action="Index">
                                <i class="bi bi-geo-alt"></i>
                                <span>Sedes</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dependencias" asp-action="Index">
                                <i class="bi bi-building"></i>
                                <span>Dependencias</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Productos" asp-action="Index">
                                <i class="bi bi-box-seam"></i>
                                <span>Productos</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Transferencias" asp-action="Index">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Transferencias</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </a>
                        </li>
                            }
                            else if (UsuarioLogueado.Rol == "AdminSede")
                            {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dependencias" asp-action="Index" asp-route-idSede="@UsuarioLogueado.IdSede">
                                <i class="bi bi-building"></i>
                                <span>Dependencias</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Productos" asp-action="Index">
                                <i class="bi bi-box-seam"></i>
                                <span>Productos</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Transferencias" asp-action="Index">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Transferencias</span>
                            </a>
                        </li>
                            }
                            else if (UsuarioLogueado.Rol == "Administrador")
                            {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Productos" asp-action="Index">
                                <i class="bi bi-box-seam"></i>
                                <span>Productos</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Clientes" asp-action="Index">
                                <i class="bi bi-person-lines-fill"></i>
                                <span>Clientes</span>
                            </a>
                        </li>
                            }
                            else
                            {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Clientes" asp-action="Index">
                                <i class="bi bi-person-lines-fill"></i>
                                <span>Clientes</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pedidos" asp-action="Index">
                                <i class="bi bi-cart"></i>
                                <span>Pedidos</span>
                            </a>
                        </li>
                            }
                    </ul>

                    <div class="user-info">
                        <div class="user-badge">
                            <i class="bi bi-person-circle"></i>
                            <span><strong>@UsuarioLogueado.Nombre</strong> | @UsuarioLogueado.Rol</span>
                        </div>
                        <a class="btn btn-logout btn-sm" asp-controller="Home" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Cerrar sesión</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
        }
    </header>

    <div class="container content-wrapper">
        <main role="main" class="main-container">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center">
        <div class="container">
            <i class="bi bi-c-circle"></i> @DateTime.Now.Year - <strong>Universidad de Caldas</strong>
            @if (!string.IsNullOrEmpty(UsuarioLogueado.NombreSede))
            {
            <span> | <i class="bi bi-geo-alt"></i> Sede: <strong>@UsuarioLogueado.NombreSede</strong></span>
            }
            @if (!string.IsNullOrEmpty(UsuarioLogueado.NombreDependencia))
            {
            <span> | <i class="bi bi-building"></i> @UsuarioLogueado.NombreDependencia</span>
            }
            <span> | Sistema de Inventario Multi-Sede</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>