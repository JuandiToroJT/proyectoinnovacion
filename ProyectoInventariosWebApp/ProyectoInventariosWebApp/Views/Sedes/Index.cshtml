@model IEnumerable<ProyectoInventariosWebApp.Controllers.Sede>

    @{
    ViewData["Title"] = "Sedes";
    var esSuperAdmin = ProyectoInventariosWebApp.Models.UsuarioLogueado.Rol == "SuperAdmin";
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <h2><i class="bi bi-geo-alt"></i> Gestión de Sedes</h2>
            <p class="text-muted">Administra las sedes de la Universidad</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    @if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Código</th>
                            <th>Ciudad</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sede in Model)
                        {
                        <tr>
                            <td>
                                <strong>@sede.Nombre</strong>
                                @if (!string.IsNullOrEmpty(sede.Direccion))
                                    {
                                <br><small class="text-muted">@sede.Direccion</small>
                                    }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(sede.Codigo))
                                    {
                                <span class="badge bg-secondary">@sede.Codigo</span>
                                    }
                                    else
                                    {
                                <span class="text-muted">-</span>
                                    }
                            </td>
                            <td>@(sede.Ciudad ?? "-")</td>
                            <td>@(sede.Telefono ?? "-")</td>
                            <td>
                                @if (sede.Activa)
                                    {
                                <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                <span class="badge bg-danger">Inactiva</span>
                                    }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@sede.IdSede"
                                       class="btn btn-sm btn-outline-primary" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Dependencias" asp-action="Index" asp-route-idSede="@sede.IdSede"
                                       class="btn btn-sm btn-outline-info" style="background-color: lightblue;" title="Ver dependencias">
                                        <i class="bi bi-building"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                <p class="text-muted mt-3">No hay sedes registradas</p>
                @if (esSuperAdmin)
                {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Crear Primera Sede
                </a>
                }
            </div>
        }
        </div>
    </div>

    <style>
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
        }

        .btn-group .btn {
            border-radius: 0;
        }

            .btn-group .btn:first-child {
                border-top-left-radius: 0.25rem;
                border-bottom-left-radius: 0.25rem;
            }

            .btn-group .btn:last-child {
                border-top-right-radius: 0.25rem;
                border-bottom-right-radius: 0.25rem;
            }
    </style>
