@model dynamic

@{
    ViewData["Title"] = "Detalle de Sede";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Detalle de Sede</h2>
    </div>
    @if (ProyectoInventariosWebApp.Models.UsuarioLogueado.Rol != "AdminSede")
    {
        <div class="col-md-6 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    }
</div>

<div class="row">
    <!-- Información de la Sede -->
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Información General</h5>
            </div>
            <div class="card-body" id="sedeInfo">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>

        <!-- Estadísticas Rápidas -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Estadísticas</h5>
            </div>
            <div class="card-body" id="estadisticas">
                <div class="text-center py-4">
                    <div class="spinner-border text-info" role="status"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dependencias -->
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Dependencias</h5>
            </div>
            <div class="card-body" id="dependenciasList">
                <div class="text-center py-4">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
        </div>

        <!-- Inventario Consolidado -->
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Inventario Consolidado de la Sede</h5>
            </div>
            <div class="card-body" id="inventarioConsolidado">
                <div class="text-center py-4">
                    <div class="spinner-border text-warning" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const baseUrl = '@ViewBag.ApiUrl';
        const idSede = @ViewBag.IdSede;

        console.log('[DEBUG] Base URL:', baseUrl);
        console.log('[DEBUG] API URL:', baseUrl);
        console.log('[DEBUG] ID Sede:', idSede);

        $(document).ready(function() {
            cargarSedeInfo();
            cargarDependencias();
            cargarInventarioConsolidado();
        });

        async function cargarSedeInfo() {
            try {
                const url = `${baseUrl}/Sedes/${idSede}`;
                console.log('[INFO] Cargando sede desde:', url);

                const response = await fetch(url);

                console.log('[INFO] Status de respuesta:', response.status);

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const sede = await response.json();

                console.log('[INFO] Sede recibida:', sede);

                let html = `
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Código:</dt>
                        <dd class="col-sm-8"><code>${sede.codigo || 'N/A'}</code></dd>

                        <dt class="col-sm-4">Nombre:</dt>
                        <dd class="col-sm-8"><strong>${sede.nombre}</strong></dd>

                        <dt class="col-sm-4">Dirección:</dt>
                        <dd class="col-sm-8">${sede.direccion || 'N/A'}</dd>

                        <dt class="col-sm-4">Teléfono:</dt>
                        <dd class="col-sm-8">${sede.telefono || 'N/A'}</dd>

                        <dt class="col-sm-4">Horario:</dt>
                        <dd class="col-sm-8"><small>${sede.horarioLaboral || 'No especificado'}</small></dd>

                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            <span class="badge ${sede.estado ? 'bg-success' : 'bg-danger'}">
                                ${sede.estado ? 'Activa' : 'Inactiva'}
                            </span>
                        </dd>
                    </dl>
                `;

                $('#sedeInfo').html(html);
            } catch (error) {
                console.error('[ERROR] Al cargar sede:', error);
                $('#sedeInfo').html(`
                    <div class="alert alert-danger">
                        <strong>Error:</strong> ${error.message}
                        <br><small>URL: ${baseUrl}/Sedes/${idSede}</small>
                    </div>
                `);
            }
        }

        async function cargarDependencias() {
            try {
                const url = `${baseUrl}/Sedes/${idSede}/Dependencias`;
                console.log('[INFO] Cargando dependencias desde:', url);

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const dependencias = await response.json();

                console.log('[INFO] Dependencias recibidas:', dependencias.length);

                if (dependencias.length === 0) {
                    $('#dependenciasList').html('<p class="text-muted text-center">No hay dependencias registradas</p>');
                    $('#estadisticas').html(`
                        <div class="text-center">
                            <h3 class="text-muted">0</h3>
                            <p class="mb-0">Dependencias</p>
                        </div>
                    `);
                    return;
                }

                let html = '<div class="list-group">';
                dependencias.forEach(dep => {
                    const estadoBadge = dep.estado ?
                        '<span class="badge bg-success">Activa</span>' :
                        '<span class="badge bg-secondary">Inactiva</span>';

                    html += `
                        <a href="/Dependencias/Details/${dep.idDependencia}" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">${dep.nombre}</h6>
                                    <p class="mb-1 text-muted small">
                                        <i class="bi bi-tag"></i> ${dep.tipoDependencia || 'Sin tipo'}
                                    </p>
                                    ${dep.ubicacion ? `<small class="text-muted"><i class="bi bi-geo-alt"></i> ${dep.ubicacion}</small>` : ''}
                                </div>
                                <div class="text-end">
                                    ${estadoBadge}
                                </div>
                            </div>
                        </a>
                    `;
                });
                html += '</div>';

                $('#dependenciasList').html(html);

                const activas = dependencias.filter(d => d.estado).length;
                $('#estadisticas').html(`
                    <div class="row text-center">
                        <div class="col-6">
                            <h3 class="text-primary">${dependencias.length}</h3>
                            <p class="mb-0 small">Total Dependencias</p>
                        </div>
                        <div class="col-6">
                            <h3 class="text-success">${activas}</h3>
                            <p class="mb-0 small">Activas</p>
                        </div>
                    </div>
                `);
            } catch (error) {
                console.error('[ERROR] Al cargar dependencias:', error);
                $('#dependenciasList').html(`
                    <div class="alert alert-danger">
                        <strong>Error:</strong> ${error.message}
                        <br><small>URL: ${baseUrl}/Sedes/${idSede}/Dependencias</small>
                    </div>
                `);
            }
        }

        async function cargarInventarioConsolidado() {
            try {
                const url = `${baseUrl}/Sedes/${idSede}/Inventario`;
                console.log('[INFO] Cargando inventario desde:', url);

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const data = await response.json();

                console.log('[INFO] Inventario recibido:', data);

                if (!data.inventario || data.inventario.length === 0) {
                    $('#inventarioConsolidado').html('<p class="text-muted text-center">No hay inventario registrado en esta sede</p>');
                    return;
                }

                let html = `
                    <div class="alert alert-info mb-3">
                        <strong>Sede:</strong> ${data.sede} |
                        <strong>Total de productos:</strong> ${data.totalProductos} |
                        <strong>Stock total:</strong> ${data.stockTotal.toLocaleString()} unidades
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th class="text-center">Precio</th>
                                    <th class="text-center">Stock Total</th>
                                    <th class="text-center">Dependencias</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                data.inventario.forEach(item => {
                    const stockClass = item.stockTotal < 50 ? 'text-danger fw-bold' : 'text-success';
                    html += `
                        <tr>
                            <td><code>${item.codigo}</code></td>
                            <td>
                                <strong>${item.nombre}</strong>
                                ${item.stockTotal < 50 ? '<i class="bi bi-exclamation-triangle text-warning" title="Stock bajo"></i>' : ''}
                            </td>
                            <td class="text-center">${item.precio.toLocaleString('es-CO', {style: 'currency', currency: 'COP'})}</td>
                            <td class="text-center ${stockClass}">${item.stockTotal}</td>
                            <td class="text-center">
                                <span class="badge bg-info">${item.dependencias.length}</span>
                            </td>
                        </tr>
                    `;
                });

                html += '</tbody></table></div>';

                if (data.inventario.length > 20) {
                    html += `<p class="text-muted text-center mt-2">Mostrando primeros 20 de ${data.inventario.length} productos</p>`;
                }

                $('#inventarioConsolidado').html(html);
            } catch (error) {
                console.error('[ERROR] Al cargar inventario:', error);
                $('#inventarioConsolidado').html(`
                    <div class="alert alert-danger">
                        <strong>Error:</strong> ${error.message}
                        <br><small>URL: ${baseUrl}/Sedes/${idSede}/Inventario</small>
                    </div>
                `);
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
