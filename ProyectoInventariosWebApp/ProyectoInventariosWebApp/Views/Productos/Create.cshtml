@model ProyectoInventariosWebApp.Models.ProductoConInventario

@{
    ViewData["Title"] = "Crear Producto";
}

<h2>Crear Nuevo Producto</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="card">
                <div class="card-header">
                    <h5>Información del Producto</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Categoria" class="form-label"></label>
                            <select asp-for="Categoria" class="form-select">
                                <option value="">Seleccionar categoría</option>
                                <option value="Papelería">Papelería</option>
                                <option value="Cafetería">Cafetería</option>
                                <option value="Laboratorio">Laboratorio</option>
                                <option value="Arte">Arte</option>
                                <option value="Tecnología">Tecnología</option>
                                <option value="Oficina">Oficina</option>
                                <option value="Otros">Otros</option>
                            </select>
                            <span asp-validation-for="Categoria" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label"></label>
                            <div class="input-group d-flex" style="flex-direction: row;">
                                <span class="input-group-text">$</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" required />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UnidadMedida" class="form-label"></label>
                            <select asp-for="UnidadMedida" class="form-select">
                                <option value="">Seleccionar</option>
                                <option value="Unidad">Unidad</option>
                                <option value="Paquete">Paquete</option>
                                <option value="Caja">Caja</option>
                                <option value="Resma">Resma</option>
                                <option value="Kilogramo">Kilogramo</option>
                                <option value="Litro">Litro</option>
                                <option value="Metro">Metro</option>
                            </select>
                            <span asp-validation-for="UnidadMedida" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="EsCompartible" class="form-check-input" type="checkbox" checked />
                            <label asp-for="EsCompartible" class="form-check-label"></label>
                            <div class="form-text">
                                Si está marcado, este producto puede ser transferido entre diferentes sedes
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Crear Producto
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </div>
        </form>
    </div>

    <div class="col-md-4">
        <div class="alert alert-info">
            <h6><i class="bi bi-info-circle"></i> Información</h6>
            <ul class="mb-0">
                <li>El <strong>código</strong> se generará automáticamente</li>
                <li>El <strong>stock</strong> se configurará por dependencia después</li>
                <li>El <strong>stock mínimo</strong> por defecto será 10 unidades</li>
                <li>Productos <strong>compartibles</strong> pueden moverse entre sedes</li>
                <li>Productos <strong>no compartibles</strong> son exclusivos de una ubicación</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
