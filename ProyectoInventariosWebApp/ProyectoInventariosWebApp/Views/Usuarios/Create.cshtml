@model ProyectoInventariosWebApp.Models.Usuarios

@{
    ViewData["Title"] = "Crear Usuario";
}

<h2>Crear Nuevo Usuario</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Información Personal</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" type="email" required />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Contrasena" class="form-label">Contraseña</label>
                            <input asp-for="Contrasena" class="form-control" type="password" required />
                            <span asp-validation-for="Contrasena" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="ConfirmarContrasena" class="form-label">Confirmar Contraseña</label>
                            <input name="ConfirmarContrasena" class="form-control" type="password" required />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Rol y Permisos</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol" class="form-select" id="selectRol" required>
                            <option value="">Seleccionar rol</option>
                            @foreach (var rol in ViewBag.Roles)
                            {
                            <option value="@rol.Value">@rol.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                        <div class="form-text" id="rolHelp">Selecciona el rol para ver las opciones disponibles</div>
                    </div>

                    <div class="row" id="asignacionContainer" style="display: none;">
                        <div class="col-md-6 mb-3" id="sedeContainer" style="display: none;">
                            <label asp-for="IdSede" class="form-label">Sede</label>
                            <select asp-for="IdSede" class="form-select" asp-items="ViewBag.Sedes">
                                <option value="">Ninguna</option>
                            </select>
                            <span asp-validation-for="IdSede" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3" id="dependenciaContainer" style="display: none;">
                            <label asp-for="IdDependencia" class="form-label">Dependencia</label>
                            <select asp-for="IdDependencia" class="form-select" asp-items="ViewBag.Dependencias">
                                <option value="">Ninguna</option>
                            </select>
                            <span asp-validation-for="IdDependencia" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Crear Usuario
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </div>
        </form>
    </div>

    <div class="col-md-4">
        <div class="alert alert-info">
            <h6><i class="bi bi-info-circle"></i> Roles Disponibles</h6>
            <ul class="mb-0 small">
                <li><strong>Super Admin:</strong> Acceso total al sistema</li>
                <li><strong>Admin Sede:</strong> Administra una sede específica</li>
                <li><strong>Encargado Dependencia:</strong> Gestiona una dependencia</li>
                <li><strong>Cliente:</strong> Usuario final que realiza pedidos</li>
                <li><strong>Administrador/Empleado:</strong> Roles legacy del sistema anterior</li>
            </ul>
        </div>

        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle"></i> Nota</h6>
            <p class="mb-0 small">
                La contraseña debe tener al menos 6 caracteres.
                El usuario recibirá un correo con sus credenciales.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script>
        $(document).ready(function () {
            $('#selectRol').change(function () {
                const rol = $(this).val();

                $('#asignacionContainer').hide();
                $('#sedeContainer').hide();
                $('#dependenciaContainer').hide();

                $('#IdSede').val('');
                $('#IdDependencia').val('');

                if (rol === 'AdminSede') {
                    $('#asignacionContainer').show();
                    $('#sedeContainer').show();
                    $('#rolHelp').text('Admin de Sede: Debe asignar una sede');
                } else if (rol === 'EncargadoDependencia') {
                    $('#asignacionContainer').show();
                    $('#sedeContainer').show();
                    $('#dependenciaContainer').show();
                    $('#rolHelp').text('Encargado de Dependencia: Debe asignar sede y dependencia');
                } else if (rol === 'SuperAdmin') {
                    $('#rolHelp').text('Super Admin: Acceso total al sistema, sin restricciones de sede');
                } else if (rol === 'Cliente') {
                    $('#asignacionContainer').show();
                    $('#sedeContainer').show();
                    $('#rolHelp').text('Cliente: Puede asignar una sede predeterminada (opcional)');
                } else if (rol === 'Administrador' || rol === 'Empleado') {
                    $('#rolHelp').text('Rol Legacy: Compatible con el sistema anterior');
                } else {
                    $('#rolHelp').text('Selecciona el rol para ver las opciones disponibles');
                }
            });
        });
    </script>
}
