@model IEnumerable<ProyectoInventariosWebApp.Models.Usuarios>

    @{
    ViewData["Title"] = "Usuarios";
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <h2>Gestión de Usuarios</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Nuevo Usuario
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Sede</th>
                            <th>Dependencia</th>
                            <th>Estado</th>
                            <th>Último Acceso</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var rolBadge = item.Rol switch
                            {
                                "SuperAdmin" => "bg-danger",
                                "AdminSede" => "bg-warning text-dark",
                                "EncargadoDependencia" => "bg-info",
                                "Cliente" => "bg-secondary",
                                "Administrador" => "bg-primary",
                                "Empleado" => "bg-success",
                                _ => "bg-secondary"
                            };

                            var rolNombre = item.Rol switch
                            {
                                "SuperAdmin" => "Super Admin",
                                "AdminSede" => "Admin Sede",
                                "EncargadoDependencia" => "Encargado Dep.",
                                "Cliente" => "Cliente",
                                "Administrador" => "Administrador",
                                "Empleado" => "Empleado",
                                _ => item.Rol
                            };

                        <tr>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@item.Correo</td>
                            <td>
                                <span class="badge @rolBadge">@rolNombre</span>
                            </td>
                            <td>
                                @if (item.IdSede.HasValue)
                                    {
                                <span class="text-muted">Sede @item.IdSede</span>
                                    }
                                    else
                                    {
                                <span class="text-muted">-</span>
                                    }
                            </td>
                            <td>
                                @if (item.IdDependencia.HasValue)
                                    {
                                <span class="text-muted">Dep. @item.IdDependencia</span>
                                    }
                                    else
                                    {
                                <span class="text-muted">-</span>
                                    }
                            </td>
                            <td>
                                @if (item.Estado)
                                    {
                                <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                <span class="badge bg-danger">Inactivo</span>
                                    }
                            </td>
                            <td>
                                @if (item.UltimoAcceso.HasValue)
                                    {
                                <small>@item.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                <small class="text-muted">Nunca</small>
                                    }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-outline-info" style="background-color: lightblue;" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-people" style="font-size: 3rem;"></i>
                                <p class="mt-2">No hay usuarios registrados</p>
                                <a asp-action="Create" class="btn btn-primary">Crear primer usuario</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @section Scripts {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    }
